# ========================================================
# NAVBATBOR.UZ — ATROF-MUHIT O'ZGARUVCHILARI (.ENV.EXAMPLE)
# ========================================================

# 1. CORE APPLICATION & HOSTING
# APP_URL: Cloud Run yoki domen havolasi (Webhook va qayta yo'naltirishlar uchun)
APP_URL="https://your-domain.com"
PORT=3000
NODE_ENV="production"

# 2. GEMINI AI (Ixtiyoriy)
GEMINI_API_KEY=""

# 3. MIJOZ TELEGRAM BOTI (CUSTOMER BOT — @Navbat1Uzb_bot)
# Mijozlarga navbat cheklari, eslatmalar va bron vaucherlarini yuboruvchi bot
TELEGRAM_BOT_TOKEN="8751009610:AAFWdNUxjcupYsp6ZA3TnWHTbxKmELbN-R0"
TELEGRAM_ADMIN_CHAT_ID="5564730141"

# 4. ALOHIDA BIZNES TELEGRAM BOTI (NAVBATBOR BUSINESS BOT)
# Biznes egalari va xodimlar uchun eksklyuziv boshqaruv boti
# 1) Telegramda @BotFather ga kiring va yangi bot yarating: /newbot
# 2) Olingan tokenni BUSINESS_BOT_TOKEN ga qo'ying
BUSINESS_BOT_TOKEN="8658895694:AAG7C0Kt8DOyhPtoCJ5koc7zrdKgzMhV59s"
BUSINESS_BOT_USERNAME="NavbatBorBusinessBot"

# Super Adminlar ro'yxati (vergul bilan ajratilgan Telegram ID raqamlari)
# Masalan: "108923481,987654321" (Telegramda @userinfobot orqali o'z IDingizni bilib olasiz)
SUPER_ADMIN_TELEGRAM_IDS="5564730141"

# Webhook xavfsizlik maxfiy kaliti (Telegram x-telegram-bot-api-secret-token orqali tekshiriladi)
BUSINESS_BOT_WEBHOOK_SECRET="navbatbor_biz_webhook_secret_key"

# 5. TO'LOV INTEGRATSIYALARI (CLICK & PAYME)
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_KEY=""

# ========================================================
# O'RNATISH VA SOZLASH QO'LLANMASI (SETUP GUIDE)
# ========================================================
#
# A. BOTFATHER DA BIZNES BOTNI YARATISH:
# 1. Telegramda @BotFather ga yozing: /newbot
# 2. Nomini kiriting: masalan "NavbatBor Biznes Boti"
# 3. Usernameni kiriting: masalan "navbatbor_business_bot"
# 4. Berilgan HTTP API tokenni BUSINESS_BOT_TOKEN ga qo'ying.
# 5. Buyruqlarni sozlash (/setcommands):
#    start - Botni ishga tushirish va menyu
#    queue - Jonli navbat va mijozlar
#    next - Keyingi mijozni chaqirish
#    walkin - Jonli navbatga mijoz qo'shish
#    dashboard - Kundalik statistika va tushum
#    help - Yordam va ma'lumot
#    cancel - Joriy amalni bekor qilish
#
# B. PRODUCTION WEBHOOKNI SOZLASH:
# Telegram rasmiy webhook o'rnatish so'rovi:
# curl -F "url=https://your-domain.com/api/telegram/business-bot-webhook" \
#      -F "secret_token=navbatbor_biz_webhook_secret_key" \
#      https://api.telegram.org/bot<BUSINESS_BOT_TOKEN>/setWebhook
#
# C. LOKAL TEST (LOCAL DEV):
# Agar Webhook sozlanmagan bo'lsa, tizim avtomatik Long Polling rejimida
# yangi xabarlarni uzluksiz qabul qilib turadi.
